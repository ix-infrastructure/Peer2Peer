# Copyright 2026 Ix Infrastructure Inc.
#
# Settings for an OPEN, internet-facing Peer2Peer relay (compose.yaml). Copy to relay.env
# (never committed) and edit. docs/run-a-relay.md documents every variable;
# docs/future/public-relay.md explains these choices.
# PORT, HOST, DB_PATH, TRUST_PROXY and the metrics listener are set in compose.yaml.

# --- identity of the relay ----------------------------------------------------
# The canonical URL. Choose it once: capabilities and identity documents name it.
RELAY_URL=wss://relay.example.org/v3
RELAY_NAME=Example relay
# The abuse / operator contact: an address that a person reads.
OPERATOR_CONTACT=mailto:abuse@example.org
RELAY_POLICY=Open relay. Carries end-to-end encrypted envelopes only; logs are counters, no contents, ids hashed. Envelopes are deleted on ack or after 7 days. Abuse: see operator contact.

# --- logs -----------------------------------------------------------------------
# info: JSON counters and events, no ids or IPs. Never run debug in production.
LOG_LEVEL=info

# --- anti-abuse for an open relay -----------------------------------------------
# Proof-of-work on first-contact messages (no capability). Friends pay nothing.
# 16 bits is well under a second on a laptop; raise toward 20 under spam.
POW_BITS=16

# Disk: the store target and hard cap (these are the defaults: 4 GiB / 5 GiB).
# Sized for a 40 GB disk with KEEP=2 local backups (docs/future/public-relay.md, "Disk budget");
# on a 25 GB disk use 3221225472 / 3758096384 and KEEP=1.
LIMIT_STORE_MAX_BYTES=4294967296
LIMIT_STORE_HARD_MAX_BYTES=5368709120
# Connections: the memory limit (512 MB) is the real ceiling on a small VM.
LIMIT_MAX_CONNECTIONS=5000
LIMIT_MAX_UNAUTH_CONNECTIONS=1000
# Everything else keeps the protocol defaults (docs/run-a-relay.md, "Choosing limits"):
# per-IP, per-user, per-pair and per-source byte limits, eviction by source, invite budgets.
