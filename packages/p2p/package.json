{
  "name": "@peer2peer/cli",
  "version": "0.1.0",
  "description": "The standalone Peer2Peer v3 CLI (`p2p`): an account-free identity, friends, circles, end-to-end encrypted session messaging and status over open relays",
  "keywords": [
    "peer2peer",
    "p2p",
    "cli",
    "e2ee",
    "messaging",
    "claude-code",
    "codex",
    "ai-agents",
    "agent-collaboration"
  ],
  "homepage": "https://github.com/ix-infrastructure/Peer2Peer/tree/main/packages/p2p#readme",
  "bugs": {
    "url": "https://github.com/ix-infrastructure/Peer2Peer/issues"
  },
  "license": "Apache-2.0",
  "author": "Ix Infrastructure",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ix-infrastructure/Peer2Peer.git",
    "directory": "packages/p2p"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "p2p": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm --prefix ../core run build && npm --prefix ../relay run build && npm --prefix ../codex-bridge run build && npm run build",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "bench:latency": "node bench/latency.mjs",
    "soak": "node ../../scripts/soak/soak.mjs",
    "prepublishOnly": "node -e \"console.error('Do not publish from this directory: publish the tarballs scripts/release-pack.mjs builds (see docs/releasing.md).');process.exit(1)\""
  },
  "dependencies": {
    "@peer2peer/codex-bridge": "file:../codex-bridge",
    "@peer2peer/core": "file:../core",
    "commander": "15.0.0",
    "uqr": "0.1.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@peer2peer/relay": "file:../relay",
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
