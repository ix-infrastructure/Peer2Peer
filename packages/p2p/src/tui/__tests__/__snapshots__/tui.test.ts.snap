// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`frames > modals: help, confirm and a message's full text 1`] = `
" Peer2Peer  1 People  2 Held (2)  3 Messages  4 Send  5 Health                  
────────────────────────────────────────────────────────────────────────────────
● tanner@k7qm-3xpd-9twa-hf2n  you                                               
  ● [a1b2c3] relay busy  Peer2Peer@feat/tui  20s ago  (this device)             
  ┌─ Keys ───────────────────────────────────────────────────────────────────┐  
  │ 1 People 2 Held 3 Messages 4 Send 5 Health (Tab cycles)                  │  
  │ ↑/↓ or j/k move, PgUp/PgDn, g/G first/last                               │  
  │ People: m or Enter message a person or session; d doctor for them        │  
  │ Held: a accept (invites, joins) or deliver (held messages); x decline; t │  
  │ always deliver from the sender (asks first)                              │  
  │ Messages: Enter opens one; r replies (this window sends no read          │  
  │ receipts); h your inbox only or every session (history: kept encrypted   │  
  │ on this device, 30 days by default)                                      │  
  │ Send: pick, write, Enter sends; Esc cancels                              │  
  │ Health: r runs the doctor again                                          │  
  │ q or Ctrl-C quits. Nothing is accepted, sent or trusted except on your   │  
  │ key press.                                                               │  
  │ Esc closes                                                               │  
  └──────────────────────────────────────────────────────────────────────────┘  
                                                                                
                                                                                
                                                                                
                                                                                
 ↑↓ move · m message · d doctor · 1-5 screens · ? help · q quit                 "
`;

