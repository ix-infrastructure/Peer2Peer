{
  "name": "@peer2peer/core",
  "version": "0.1.0",
  "description": "Peer2Peer client crypto core: self-certifying identities, device certificates, friendships, circles, rosters and end-to-end encrypted envelopes (v3 at @peer2peer/core/v3; the root export is the frozen v2 API)",
  "keywords": [
    "peer2peer",
    "p2p",
    "end-to-end-encryption",
    "e2ee",
    "identity",
    "ed25519",
    "x25519",
    "crypto",
    "ai-agents"
  ],
  "homepage": "https://github.com/ix-infrastructure/Peer2Peer/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ix-infrastructure/Peer2Peer/issues"
  },
  "license": "Apache-2.0",
  "author": "Ix Infrastructure",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ix-infrastructure/Peer2Peer.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "import": "./dist/v3/index.js"
    },
    "./v3/node": {
      "types": "./dist/v3/node.d.ts",
      "import": "./dist/v3/node.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "node -e \"console.error('Do not publish from this directory: publish the tarballs scripts/release-pack.mjs builds (see docs/releasing.md).');process.exit(1)\""
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
